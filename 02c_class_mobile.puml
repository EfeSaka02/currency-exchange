@startuml
title Class Diagram (3/3) - Mobile application
skinparam dpi 150
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam class {
  BackgroundColor #F4F8FC
  BorderColor #1F4E79
}
hide empty members

package "Mobile application" {
  class ApiClient {
    +timeoutMs : int
    +send(request) : Response
  }
  class RateRepository {
    +getRates() : List<ExchangeRate>
    +getCachedRates() : List<ExchangeRate>
  }
  class OrderQueue {
    +enqueue(order) : void
    +retryUnconfirmed() : void
    +resolveStatus(requestKey) : Transaction
  }
  class LocalStore {
    +saveRates(rates) : void
    +savePendingOrder(order) : void
    +loadPendingOrders() : List<Order>
  }
}



RateRepository ..> ApiClient
OrderQueue ..> ApiClient
RateRepository ..> LocalStore
OrderQueue ..> LocalStore
@enduml
